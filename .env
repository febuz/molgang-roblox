# VirtualPC Autonomous Agent System - Active Configuration

# Server
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# Neo4j Graph Database (LightRAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Kafka Message Queue
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# JWT Authentication
JWT_SECRET=virtualpc-secret-key-$(date +%s)-change-in-production
TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cost Tracking
DAILY_BUDGET=50
MONTHLY_BUDGET=1500
COST_REDUCTION_TARGET=0.87

# Model Router
TIER1_MODELS=qwen-32b-instruct,deepseek-r1-7b,phi-4
TIER2_MODELS=mistral-7b,llama-2-7b
TIER3_MODELS=claude-opus-4.6,gpt-4-turbo

# LightRAG
LIGHTRAG_CACHE_SIZE=1000
LIGHTRAG_CACHE_TTL=3600

# Logging
LOG_DIR=./logs
DATA_DIR=./data

# API Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
CORS_ORIGIN=*

# Paperclip Integration
PAPERCLIP_API_URL=http://localhost:3000
PAPERCLIP_API_TOKEN=integration-token-virtualpc

# Agents
AGENT_HEARTBEAT_INTERVAL=30000
AGENT_MAX_CONCURRENT_TASKS=5

# Local GPU Inference (Ollama) — added by vitals/GPU uplift
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_MODELS=/media/knight2/EDS2/ollama-models
GPU_ENABLED=true

# Self-repair watchdog
SELF_REPAIR_ENABLED=true
SELF_REPAIR_MODE=observe
