[Unit]
Description=LiteLLM gateway for VirtualPC (port 4000)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/knight2/virtualpc
# Pull any cloud keys recorded by virtualpc into the env before bringing up
# the container. Missing keys leave their providers unusable but don't
# block local LM Studio routing from working.
EnvironmentFile=-/home/knight2/.virtualpc/llm-keys.env
# Use /snap/bin/docker (snap-confined). System docker is also at /usr/bin/docker via the snap wrapper.
ExecStart=/snap/bin/docker compose -f deploy/docker-compose.litellm.yml up -d
ExecStop=/snap/bin/docker compose -f deploy/docker-compose.litellm.yml down

[Install]
WantedBy=default.target
