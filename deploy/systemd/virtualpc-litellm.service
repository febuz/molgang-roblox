[Unit]
Description=LiteLLM gateway for VirtualPC (port 4000)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/virtualpc
# Pull any cloud keys recorded by virtualpc into the env before bringing up
# the container. Missing keys leave their providers unusable but don't
# block local LM Studio routing from working.
EnvironmentFile=-%h/.virtualpc/llm-keys.env
# /usr/bin/docker exists on most distros; falls back to /snap/bin/docker
# (Ubuntu snap-confined Docker) automatically because Docker installs the
# /usr/bin/docker shim. If neither path resolves, edit ExecStart to point
# at your docker binary.
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.litellm.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.litellm.yml down

[Install]
WantedBy=default.target
