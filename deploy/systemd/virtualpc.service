[Unit]
Description=VirtualPC API + agent system (port 3100)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
# %h expands to $HOME at unit-load time, so this works from any user account
# that has the repo cloned at ~/virtualpc. If your checkout lives elsewhere,
# set REPO_DIR=/path/to/virtualpc in ~/.config/systemd/user/virtualpc.env
# and uncomment the EnvironmentFile line below.
WorkingDirectory=%h/virtualpc
EnvironmentFile=-%h/.config/systemd/user/virtualpc.env
# LiteLLM gateway is no longer in the consolidated stack — model calls
# go straight to LM Studio (:1234). To re-enable a gateway, set
# LITELLM_URL=http://127.0.0.1:4000/v1 in virtualpc.env above.
# (Old: Environment=LITELLM_URL=http://127.0.0.1:4000/v1)
# Neo4j credentials for the LightRAG knowledge graph. Brought online May 2026
# via `docker run --name virtualpc-neo4j … neo4j:latest`. Password stored
# in this unit file (low-sensitivity, single-host dev). Rotate to a
# secrets-manager pull when Neo4j moves off-box.
Environment=NEO4J_URI=bolt://localhost:7687
Environment=NEO4J_USER=neo4j
Environment=NEO4J_PASSWORD=virtualpc-neo4j-pass
# Kafka container is dropped from the consolidated stack — silence the
# kafkajs ECONNREFUSED retry loop. Unset to re-enable when Kafka returns.
Environment=KAFKA_DISABLED=1
Environment=KAFKA_BROKERS=localhost:9092
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10s
# Graceful shutdown: index.ts handles SIGTERM (close server + flush stores
# + disconnect kafka, ≤8s). 20s safety net if that hangs.
TimeoutStopSec=20s
# control-group: SIGTERM goes to every child (vitals-monitor.sh, nvidia-smi
# spawns) so they exit cleanly instead of waiting for the timeout SIGKILL.
KillMode=control-group

# Logs (append, don't truncate)
StandardOutput=append:%h/virtualpc/logs/virtualpc.log
StandardError=append:%h/virtualpc/logs/virtualpc.log

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768

[Install]
WantedBy=default.target
