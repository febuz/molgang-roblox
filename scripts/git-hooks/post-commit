#!/usr/bin/env bash
# Post-commit hook — POSTs the new commit into virtualpc's audit trail.
#
# Installed by scripts/install.sh as a symlink at .git/hooks/post-commit.
# Silent-failure on purpose: a dev shouldn't be blocked by the audit API
# being down. Curl uses --max-time so a hung server doesn't stall the commit.

set -u

SHA=$(git rev-parse HEAD 2>/dev/null) || exit 0
SUBJECT=$(git log -1 --pretty=format:%s 2>/dev/null) || exit 0
AUTHOR=$(git log -1 --pretty=format:'%an <%ae>' 2>/dev/null) || exit 0
TIMESTAMP=$(git log -1 --pretty=format:%aI 2>/dev/null) || exit 0

URL="${VIRTUALPC_URL:-http://localhost:3100}/api/audit/commit"

# JSON body — assemble with python so the subject can contain quotes safely.
BODY=$(python3 -c "
import json, sys
print(json.dumps({
    'sha': sys.argv[1],
    'subject': sys.argv[2],
    'author': sys.argv[3],
    'timestamp': sys.argv[4],
}))
" "$SHA" "$SUBJECT" "$AUTHOR" "$TIMESTAMP" 2>/dev/null) || exit 0

curl --silent --show-error --max-time 3 \
     -H 'Content-Type: application/json' \
     -X POST "$URL" -d "$BODY" >/dev/null 2>&1 || true

# Auto-trigger playtest-runner if /play-demo.html changed in this commit.
# Runs in the background so the hook returns instantly. Findings auto-file
# as bugs to /api/scrums/scrum-web/bug; gap-thread reposts to /api/forum.
# Skip if PLAYTEST_AUTO=0 (CI / scripted commits / fast-loop sessions).
if [[ "${PLAYTEST_AUTO:-1}" == "1" ]] && \
   git diff-tree --no-commit-id --name-only -r "$SHA" 2>/dev/null | grep -q '^public/play-demo.html$'; then
  REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n "$REPO_DIR" && -x "$REPO_DIR/scripts/playtest-runner.js" ]]; then
    nohup node "$REPO_DIR/scripts/playtest-runner.js" --tester all \
      >> "$REPO_DIR/data/playtest-reports.log" 2>&1 &
    disown 2>/dev/null || true
  fi
fi

exit 0
