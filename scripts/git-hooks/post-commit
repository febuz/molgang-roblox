#!/usr/bin/env bash
# Post-commit hook — POSTs the new commit into virtualpc's audit trail.
#
# Installed by scripts/install.sh as a symlink at .git/hooks/post-commit.
# Silent-failure on purpose: a dev shouldn't be blocked by the audit API
# being down. Curl uses --max-time so a hung server doesn't stall the commit.

set -u

SHA=$(git rev-parse HEAD 2>/dev/null) || exit 0
SUBJECT=$(git log -1 --pretty=format:%s 2>/dev/null) || exit 0
AUTHOR=$(git log -1 --pretty=format:'%an <%ae>' 2>/dev/null) || exit 0
TIMESTAMP=$(git log -1 --pretty=format:%aI 2>/dev/null) || exit 0

URL="${VIRTUALPC_URL:-http://localhost:3100}/api/audit/commit"

# JSON body — assemble with python so the subject can contain quotes safely.
BODY=$(python3 -c "
import json, sys
print(json.dumps({
    'sha': sys.argv[1],
    'subject': sys.argv[2],
    'author': sys.argv[3],
    'timestamp': sys.argv[4],
}))
" "$SHA" "$SUBJECT" "$AUTHOR" "$TIMESTAMP" 2>/dev/null) || exit 0

curl --silent --show-error --max-time 3 \
     -H 'Content-Type: application/json' \
     -X POST "$URL" -d "$BODY" >/dev/null 2>&1 || true

exit 0
