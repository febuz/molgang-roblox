# Nginx reverse proxy with SSL/TLS support
FROM nginx:alpine

# Install openssl for certificate generation
RUN apk add --no-cache openssl

# Create certificate directory
RUN mkdir -p /etc/nginx/certs

# Generate self-signed certificate (for development)
# In production, use Let's Encrypt certificates
RUN openssl req -x509 -newkey rsa:4096 -keyout /etc/nginx/certs/key.pem -out /etc/nginx/certs/cert.pem -days 365 -nodes -subj "/CN=localhost"

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Create log directory
RUN mkdir -p /var/log/nginx && chmod 755 /var/log/nginx

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Expose ports
EXPOSE 80 443

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
